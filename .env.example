# SecureOps Controller (Docker) — copy to .env and edit
# Generate secrets:  openssl rand -base64 48   /   openssl rand -hex 32

# Host port the web UI is published on (SecureOps owns 80; StorageHub uses 8080)
SECUREOPS_HTTP_PORT=80

# REQUIRED for Docker (no host PAM): JWT signing key + DB admin password
SECUREOPS_JWT_SECRET=
SECUREOPS_ADMIN_PASSWORD=

# Allowed CORS origins (comma-separated; * is fine behind one nginx)
SECUREOPS_CORS_ORIGINS=*
# Send HSTS header (only when TLS is terminated upstream)
SECUREOPS_ENABLE_HSTS=0

# LogSync → StorageHub backup (optional)
SECUREOPS_STORAGEHUB_URL=
SECUREOPS_STORAGEHUB_API_KEY=
SECUREOPS_LOGSYNC_INTERVAL_MIN=15
